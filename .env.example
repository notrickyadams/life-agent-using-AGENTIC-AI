# .env.example — copy this file to `.env` and fill in the real values.
#
#   cp .env.example .env
#
# `.env` is git-ignored, so real keys never end up in the repo. Every line
# here is a placeholder name only. The exact variables may grow or change as
# each V1 step is built; this is the starting set.

# ---------------------------------------------------------------------------
# Google (V1 step 1 — Calendar + Classroom sync)
# ---------------------------------------------------------------------------
# Google's OAuth flow doesn't use a key string; it uses a JSON file you
# download from Google Cloud Console (APIs & Services -> Credentials ->
# "OAuth client ID" -> Desktop app -> Download JSON). Save that file at the
# path below. It is git-ignored.
GOOGLE_CREDENTIALS_FILE=credentials.json

# After the first sign-in, the app saves a token file here so you don't have
# to sign in every run. Also git-ignored.
GOOGLE_TOKEN_DIR=.

# Which calendars to sync, comma-separated. "primary" = your main calendar.
# Other calendar IDs look like an email address; the Phase 0 verification
# step lists the ones you have access to.
CALENDAR_IDS=primary

# Also sync every Google-Classroom-generated course calendar (ids start with
# "classroom"). Keeps new semesters working with no edits here.
CALENDAR_INCLUDE_CLASSROOM=true

# How many days back and ahead each sync pulls.
CALENDAR_DAYS_BACK=7
CALENDAR_DAYS_AHEAD=30

# ---------------------------------------------------------------------------
# Notion (V1 step 3 — write the daily view)
# ---------------------------------------------------------------------------
# Internal integration token from https://www.notion.so/my-integrations
NOTION_API_KEY=

# The ID of the Notion page or database the daily view is written into.
# Whether this is a page or a database gets decided in step 3 — leave blank
# until then. (Found in the page URL: the 32-character string at the end.)
NOTION_PARENT_ID=

# ---------------------------------------------------------------------------
# Claude API (V1 step 5 — the single daily synthesis call)
# ---------------------------------------------------------------------------
# From https://console.anthropic.com/ -> API Keys. This is the separate API
# budget, NOT the Pro subscription login.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Local model (V1 step 4 — Ollama for routine tagging/filtering)
# ---------------------------------------------------------------------------
# Not secrets, just config. Ollama runs locally; these are its defaults.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ---------------------------------------------------------------------------
# Local database
# ---------------------------------------------------------------------------
# Path to the single SQLite file. The data/ folder is git-ignored.
DB_PATH=data/agent.db

# Where run logs go. Also git-ignored.
LOG_DIR=logs
